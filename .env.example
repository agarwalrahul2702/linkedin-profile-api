# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# --- LinkedIn session (see README "Auth" section) -------------------------
# Usually populated locally by: python scripts/linkedin_login.py
LI_AT=

# Optional: the API bootstraps this CSRF cookie directly if omitted. Values
# supplied manually with or without surrounding quotes are accepted.
JSESSIONID=

# Maximum LinkedIn requests in flight across all API calls in one process.
LINKEDIN_MAX_CONCURRENCY=3

# Decoration used by LinkedIn's current profile endpoint. This undocumented
# version can change when LinkedIn deploys a new frontend schema.
PROFILE_DECORATION_ID=com.linkedin.voyager.dash.deco.identity.profile.FullProfileWithEntities-109

# Tried only if the primary decoration returns a schema-level 400/410.
PROFILE_DECORATION_FALLBACK_IDS=com.linkedin.voyager.dash.deco.identity.profile.FullProfileWithEntities-101

# Optional HTTP user-agent override used by the login helper and API client.
LINKEDIN_USER_AGENT=

# Keep false for local development. Only enable behind your own HTTPS and
# access-control layer; this endpoint accepts LinkedIn credentials.
ALLOW_REMOTE_UI_LOGIN=false

# --- Caching -----------------------------------------------------------
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# --- Batch endpoint ------------------------------------------------------
MAX_BATCH_SIZE=20
MAX_BATCH_CONCURRENCY=5
